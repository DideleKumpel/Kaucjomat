<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kaucjomat.ViewModel"
             xmlns:converters="clr-namespace:Kaucjomat.Converters"
             x:DataType="vm:VouchersViewModel"
             x:Class="Kaucjomat.View.VouchersView"
             BackgroundColor="{StaticResource SecondaryBackgroundColor}"
             x:Name="VouchersViewPage">
    
    <ContentPage.Resources>
        <converters:DateToColorConverter x:Key="DateColorConv" />
    </ContentPage.Resources>
    
    <Shell.TitleView>
        <Label Text="TWOJE VOUCHERY"
               TextColor="{StaticResource SecondaryTextColor}"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               HorizontalTextAlignment="Center" />
    </Shell.TitleView>
    <ScrollView>
        <VerticalStackLayout Spacing="10" Margin="10">
            
            <Label Style="{StaticResource Header}"
                    Text="Wybierz sklep"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" />
            <Border Padding="15,5" 
                    StrokeShape="RoundRectangle 20" StrokeThickness="2"
                    BackgroundColor="{StaticResource BackgroundColor}"
                    >
                <Picker FontSize="26" Style="{StaticResource Main}"
                        Title="Wybierz..."
                        ItemsSource="{Binding Stores}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedStore}"/>
            </Border>



            <Button Style="{StaticResource MainButton}" 
                Text="ARCHIWUM VOUCHERÓW"
                ImageSource="archive.png"
                ContentLayout="Left, 10"
                Command="{Binding GoToVouchersArchivesCommand}">
                
            </Button>

            <CollectionView SelectionMode="None"
                            ItemsSource="{Binding Vouchers}"
                            >
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10">
                            <Border Margin="0,0,0,10" Padding="15" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource BackgroundColor}">
                            <Border.Shadow>
                                <Shadow Brush="Black"
                                        Offset="2,5"
                                        Radius="10"
                                        Opacity="0.2"
                                        />
                            </Border.Shadow>
                            <Grid RowDefinitions="Auto, Auto, Auto" 
                                 ColumnDefinitions="auto, *"
                                  BackgroundColor="Transparent">

                                <Label Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource Header}"
                                       Text="Kwota"/>
                                <Label Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource Header}"
                                       Text="{Binding Amount, StringFormat='{0:F2} zł'}" 
                                       TextColor="{StaticResource PrimaryColor}"/>

                                <Label Grid.Row="0" Grid.Column="1"
                                       Style="{StaticResource Header}"
                                       HorizontalOptions="End"
                                       Text="Data ważności"/>
                                <Label Grid.Row="1" Grid.Column="1"
                                       Style="{StaticResource Header}"
                                       HorizontalOptions="End"
                                       Text="{Binding ExpiryDate, StringFormat='{0:dd.MM}'}"
                                       TextColor="{Binding ExpiryDate, Converter={StaticResource DateColorConv}}"/>

                                <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="5" Margin="0,10,0,0">
                                    <Button Style="{StaticResource MainButton}" 
                                            Text="WYŚWIETL KOD"
                                            ImageSource="view.png"
                                            ContentLayout="Left, 10"
                                            Command="{Binding BindingContext.ShowVoucherCodeCommand, Source={x:Reference VouchersViewPage}}"
                                            CommandParameter="{Binding BindingContext, Source={RelativeSource Self}}"/>
                                    <Button Style="{StaticResource RedBtn}" 
                                            Text="WYKORZYSTANY"
                                            ImageSource="check.png"
                                            ContentLayout="Left, 10"
                                            Command="{Binding BindingContext.ChangeVoucherStatusToUsedCommand, Source={x:Reference VouchersViewPage}}"
                                            CommandParameter="{Binding BindingContext, Source={RelativeSource Self}}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>