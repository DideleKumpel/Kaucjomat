<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Kaucjomat.View.VoucherAarchivesView"
             Title="VoucherAarchivesView">
    <Shell.TitleView>
        <Label Text="TWOJE VOUCHERY"
               TextColor="{StaticResource PrimaryColor}"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               HorizontalTextAlignment="Center" />
    </Shell.TitleView>
    <ScrollView>
        <VerticalStackLayout Spacing="10" Margin="10">

            <Label Style="{StaticResource Header}"
                Text="Wybierz sklep"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />
            <Picker FontSize="32">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Biedronka</x:String>
                        <x:String>LIDL</x:String>
                        <x:String>Dino</x:String>
                        <x:String>NETTO</x:String>
                        <x:String>Auchan</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Button Style="{StaticResource MainButton}" 
            Text="AKTUALNE VOUCHERY"/>

            <CollectionView SelectionMode="None">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Wpis 1</x:String>
                        <x:String>Wpis 2</x:String>
                        <x:String>Wpis 3</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Padding="15" StrokeShape="RoundRectangle 10">
                            <Grid RowDefinitions="Auto, Auto, Auto" 
                             ColumnDefinitions="*, 2*">

                                <Label Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource Header}"
                                   Text="Kwota"/>
                                <Label Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource Header}"
                                   Text="12.50zł" 
                                   TextColor="{StaticResource PrimaryColor}"/>

                                <Label Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource Header}"
                                   HorizontalOptions="End"
                                   Text="Data ważności"/>
                                <Label Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource Header}"
                                   HorizontalOptions="End"
                                   Text="12.09"/>

                                <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="5" Margin="0,10,0,0">
                                    <Button Style="{StaticResource MainButton}" 
                                        Text="WYŚWIETL KOD"/>
                                    <Button Style="{StaticResource RedBtn}" 
                                        Text="PRZYWRÓĆ"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>