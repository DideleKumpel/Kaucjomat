<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:local="clr-namespace:Kaucjomat.View.Popup"
               xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
               x:Class="Kaucjomat.View.Popup.ConformationPopUp">
    <Grid RowDefinitions="auto, *, auto"
                     MinimumHeightRequest="200"
                     MinimumWidthRequest="300">
        <Grid>
            <Button Text="X" 
                    Clicked="BtnNoClicked"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    FontSize="20"/>

            <Label Style="{StaticResource Header}" x:Name="Header"
                   Text="Message"
                   HorizontalOptions="Start"
                   VerticalOptions="Start"/>
        </Grid>

        <Label Grid.Row="1"
        Style="{StaticResource Medium}" x:Name="Message"/>

        <Grid Grid.Row="2"
            ColumnDefinitions="*,10,*">
            
            <Button Style="{StaticResource MainButton}"
                    BorderColor="{StaticResource SuccesColor}"
                    TextColor="{StaticResource SuccesColor}"
                    Text="Nie"
                    Clicked="BtnNoClicked"/>
            
            <Button Grid.Column="2"
                    Style="{StaticResource MainButton}"
                    Text="Tak"
                    Clicked="BtnYesClicked"/>
        </Grid>
    </Grid>
</toolkit:Popup>