<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:local="clr-namespace:Kaucjomat.View.Popup"
               xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
               xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
               x:Class="Kaucjomat.View.Popup.MessagePopup">
    <Grid RowDefinitions="auto, *, auto"
                         MinimumHeightRequest="200"
                         MinimumWidthRequest="300">
        <Grid>
            <Button Text="X" 
                Clicked="OnCloseClicked"
                HorizontalOptions="End"
                VerticalOptions="Start"
                BackgroundColor="Transparent"
                TextColor="Gray"
                FontSize="20"/>

            <Label Style="{StaticResource Header}" x:Name="Header"
                   Text="Message"
                   HorizontalOptions="Start"
                   VerticalOptions="Start"/>
        </Grid>

        <Label Grid.Row="1"
            Style="{StaticResource Medium}" x:Name="Message"/>

        <Button Grid.Row="2"
                Style="{StaticResource RedBtn}"
                Text="Zamknij"
                Clicked="OnCloseClicked"/>
    </Grid>
</toolkit:Popup>