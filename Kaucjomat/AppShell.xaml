<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Kaucjomat.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Kaucjomat"
    xmlns:views="clr-namespace:Kaucjomat.View"
    Title="Kaucjomat">

    <TabBar>
        <Tab Title="Home" Icon="home.png">
            <ShellContent ContentTemplate="{DataTemplate views:HomeView}"/>
        </Tab>
        <Tab Title="Vouchery" Icon="coupon_grey.png">
            <ShellContent ContentTemplate="{DataTemplate views:VouchersView}"/>
        </Tab>
        <Tab Title="Dodaj" Icon="add.png">
            <ShellContent ContentTemplate="{DataTemplate views:AddNewView}"/>
        </Tab>
        <Tab Title="Sklepy" Icon="shop.png">
            <ShellContent ContentTemplate="{DataTemplate views:ShopsView}"/>
        </Tab>
    </TabBar>

</Shell>
